{
  "appearance": {
    "transparency": {
      "enabled": true
    },
    "rounding": {
      "scale": 1.0
    },
    "spacing": {
      "scale": 0.85
    },
    "padding": {
      "scale": 0.9
    },
    "font": {
      "scale": 0.75,
