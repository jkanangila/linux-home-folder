{
    "appearance": {
        "font": {
            "scale": 0.75
        },
        "padding": {
            "scale": 0.9
        },
        "rounding": {
            "scale": 1
        },
        "spacing": {
            "scale": 0.85
        },
        "transparency": {
            "enabled": true
        }
    },
    "background": {
        "wallpaperEnabled": true
    },
    "border": {
        "thickness": 4
    },
    "dashboard": {
        "dragThreshold": 20,
        "enabled": true
    },
    "general": {
        "apps": {
            "audio": [
                "tauon"
            ]
        }
    },
    "services": {
        "clockFormat": "TwentyFourHour",
        "dataUnits": "Decimal",
        "defaultPlayer": "strawberry",
        "weatherUnits": "Celsius"
    },
    "session": {
        "commands": {
            "hibernate": [
                "systemctl",
                "hibernate"
            ]
        },
        "enabled": true,
        "icons": {
            "hibernate": "bedtime"
        }
    }
}
