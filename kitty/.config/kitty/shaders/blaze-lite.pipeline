# Lightweight, single-pass amber cursor trail.
startgroup
    animation_start cursor-trail-move
    animation_stop cursor-trail-stop
    animation_step 33

    var float GLOW_RADIUS = 9.0
    var float GLOW_STRENGTH = 0.24
    var float CORE_STRENGTH = 0.88
    var float EDGE_WIDTH = 2.2
    var float AA_WIDTH = 1.35

    shaders blaze-lite
endgroup
