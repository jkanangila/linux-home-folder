# vim: ft=zsh
# chpwd hook: activate a project's pipenv virtualenv when you enter a directory
# containing a Pipfile, and deactivate it again when you leave that project.

# ── Entering a project (Pipfile present, no environment active) ──────────
if [[ -f Pipfile && -z $VIRTUAL_ENV ]]; then
  local venv_path
  if [[ -r .venv/bin/activate ]]; then
    # PIPENV_VENV_IN_PROJECT=1 puts the venv in ./.venv — skips pipenv's slow startup
    venv_path="$PWD/.venv"
  else
    venv_path="$(pipenv --venv 2>/dev/null)"
  fi

  if [[ -n $venv_path && -r $venv_path/bin/activate ]]; then
    print "💡 Pipfile detected. Activating virtual environment..."
    export PIPENV_SHELL_ORIGIN_DIR="$PWD"
    source "$venv_path/bin/activate"
  fi
  return
fi

# ── Leaving (we activated an env and PWD is no longer inside that project) ─
if [[ -n $VIRTUAL_ENV && -n $PIPENV_SHELL_ORIGIN_DIR ]]; then
  if [[ $PWD != "$PIPENV_SHELL_ORIGIN_DIR" && $PWD != "$PIPENV_SHELL_ORIGIN_DIR"/* ]]; then
    print "👋 Left project directory. Deactivating virtual environment..."
    unset PIPENV_SHELL_ORIGIN_DIR
    deactivate
  fi
fi
